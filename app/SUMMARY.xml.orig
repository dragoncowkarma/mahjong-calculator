<?xml version="1.0" encoding="UTF-8"?>
<ProjectContext>
  <Meta>
    <Purpose>A Kotlin Multiplatform Mahjong calculator that uses camera-based tile detection and a complex scoring engine to evaluate Japanese Mahjong hands, calculating Yaku, Fu, and total points.</Purpose>
    <KotlinVersion>2.1.0</KotlinVersion>
    <Targets>android, iosArm64, iosSimulatorArm64</Targets>
    <Architecture>MVVM/MVI with Voyager ScreenModel and Kotlin-Inject for Dependency Injection.</Architecture>
  </Meta>

  <Dependencies>
    <Package name="Voyager" purpose="Multiplatform navigation and state management via Screen and ScreenModel interfaces."/>
    <Package name="Kotlin-Inject" purpose="Compile-time dependency injection using KSP for zero-reflection DI."/>
    <Package name="Compose Multiplatform" purpose="Shared UI framework for Android and iOS using Jetpack Compose syntax."/>
    <Package name="Ktor" purpose="Not explicitly in use for networking yet, but common in KMP stacks (absent from current libs.versions.toml)."/>
  </Dependencies>

  <ProjectStructure>
    <Module name="composeApp">
      <SourceSet name="commonMain">
        <Description>Shared business logic, UI components, and navigation. Contains the Mahjong calculation engine, tile detection abstractions, and Voyager screens/models.</Description>
      </SourceSet>
      <SourceSet name="androidMain">
        <Description>Android entry point (MainActivity) and platform-specific implementations of Platform and AppComponent.</Description>
      </SourceSet>
      <SourceSet name="iosMain">
        <Description>iOS entry point (MainViewController), camera feed integration, and platform-specific implementations of Platform and AppComponent.</Description>
      </SourceSet>
    </Module>
    <Module name="iosApp">
      <SourceSet name="Swift">
        <Description>Native Swift wrapper and entry point for the iOS application, bridging to the ComposeApp framework.</Description>
      </SourceSet>
    </Module>
  </ProjectStructure>

  <CoreComponents>
    <Component name="MahjongScreenModel" type="ScreenModel">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/ui/MahjongScreenModel.kt</Path>
      <Responsibility>Manages UI state, coordinates hand detection via TileDetectionModel, and orchestrates score calculation using MahjongCalculator.</Responsibility>
    </Component>
    <Component name="YakuListScreen" type="Screen">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/ui/YakuListScreen.kt</Path>
      <Responsibility>Displays a categorized list of Japanese Mahjong Yakus in Korean.</Responsibility>
    </Component>
    <Component name="YakuData" type="Model">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/models/YakuData.kt</Path>
      <Responsibility>Holds static hardcoded list of Mahjong Yakus (YakuInfo) and their descriptions in Korean.</Responsibility>
    </Component>
    <Component name="MahjongCalculator" type="Logic">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/calculator/MahjongCalculator.kt</Path>
      <Responsibility>The main orchestration engine that calculates Yaku, Fu, and total points for a given Mahjong hand and context.</Responsibility>
    </Component>
    <Component name="TileDetectionModel" type="Repository">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/models/TileDetectionModel.kt</Path>
      <Responsibility>Abstract interface for detecting Mahjong tiles from raw camera frame data (ByteArray).</Responsibility>
    </Component>
    <Component name="AgariEvaluator" type="Logic">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/models/AgariEvaluator.kt</Path>
      <Responsibility>Determines if a given set of tiles forms a valid winning hand (Agari).</Responsibility>
    </Component>
    <Component name="AppComponent" type="DI">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/AppComponent.kt</Path>
      <Responsibility>The root DI component interface, implemented on each platform to provide dependencies like Platform and TileDetectionModel.</Responsibility>
    </Component>
    <Component name="TileRecognitionScreen" type="Screen">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/ui/TileRecognitionScreen.kt</Path>
      <Responsibility>Provides UI for picking images from Gallery or Camera, and displays spatial recognition of tiles categorized by Hand, Discards, and Melds.</Responsibility>
    </Component>
    <Component name="TileRecognitionScreenModel" type="ScreenModel">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/ui/TileRecognitionScreenModel.kt</Path>
      <Responsibility>Manages state for image recognition and processes bounding boxes into spatial categories (Hand vs Discard vs Melds).</Responsibility>
    </Component>
    <Component name="ImagePicker" type="Interface">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/models/ImagePicker.kt</Path>
      <Responsibility>Platform-agnostic interface for picking images from Gallery or Camera.</Responsibility>
    </Component>
    <Component name="ImageBitmapDecoder" type="Interface">
      <Path>composeApp/src/commonMain/kotlin/com/dragoncowkarma/mahcalc/models/ImageBitmapDecoder.kt</Path>
      <Responsibility>Platform-agnostic interface for decoding byte arrays into ImageBitmap for UI preview.</Responsibility>
    </Component>
  </CoreComponents>

  <PlatformIntegrations>
    <Implementation expected="Platform">
       <Detail platform="Android">Implemented as AndroidPlatform in androidMain, providing Android-specific metadata.</Detail>
       <Detail platform="iOS">Implemented as IosPlatform in iosMain, providing iOS-specific metadata.</Detail>
    </Implementation>
    <Implementation expected="AppComponent">
       <Detail platform="Android">AndroidAppComponent in androidMain provides Android-specific dependencies to the app.</Detail>
       <Detail platform="iOS">IosAppComponent in iosMain provides iOS-specific dependencies, including CameraFeedManager.</Detail>
    </Implementation>
  </PlatformIntegrations>

  <DataFlowAndState>
    <Description>UI state is held in Voyager ScreenModels using MutableStateFlow. Screens observe state via StateFlow.collectAsState(). User actions trigger ScreenModel methods that update state asynchronously using screenModelScope.</Description>
    <Route name="YakuListScreen">Added navigation from `MahjongScreen` to `YakuListScreen` via Voyager's `navigator.push(YakuListScreen())`.</Route>
    <Route name="TileRecognitionScreen">Added navigation from `MahjongScreen` to `TileRecognitionScreen` via Voyager's `navigator.push(TileRecognitionScreen(component))`.</Route>
  </DataFlowAndState>

  <StrictConventions>
    <Rule>Use Voyager for all cross-platform navigation and UI state management.</Rule>
    <Rule>State must be handled exclusively by Voyager ScreenModel instances.</Rule>
    <Rule>Inject dependencies via Kotlin-Inject; avoid reflection-based DI like Koin.</Rule>
    <Rule>Zero-fragmentation: All UI, Navigation, and Logic must reside in commonMain.</Rule>
    <Rule>Ban on expect/actual: Use interfaces and dependency injection for platform-specific APIs.</Rule>
    <Rule>All shared assets (strings, images) must be in composeResources and accessed via Compose Multiplatform Resources API.</Rule>
  </StrictConventions>
</ProjectContext>
